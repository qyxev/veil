                    android:startX="256"
                    android:startY="192"
                    android:endX="256"
                    android:endY="344"
                    android:type="linear">
                    <item android:offset="0.0" android:color="#FFFFFFFF" />
                    <item android:offset="1.0" android:color="#FFB0B0B0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- OCR Scan Beam -->
        <path
            android:pathData="M 164,256 L 348,256"
            android:strokeWidth="4"
            android:strokeColor="#66FFFFFF" />
